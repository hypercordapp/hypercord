@@ -16,17 +16,45 @@ function virtualMerge(...objects) {
     }
     const handler = {
         ownKeys() {
-            return objects.reduce((acc, obj) => {
+            // De-duped: when two merged objects share a key (the whole point of
+            // virtualMerge - e.g. overriding a real user's `username` with a fake
+            // one, where both the real object and the overrides object have a
+            // `username` key), the naive concat below returned that key twice,
+            // which throws "'ownKeys' on proxy: trap returned duplicate entries"
+            // (a hard, uncatchable TypeError) the moment anything enumerates the
+            // proxy's keys (Object.keys/entries, {...spread}, for...in, etc).
+            const keys = objects.reduce((acc, obj) => {
                 acc.push(...Reflect.ownKeys(obj));
                 return acc;
             }, Reflect.ownKeys(fallback));
+            return [...new Set(keys)];
         }
     };
-    for (const method of ["defineProperty", "deleteProperty", "get", "getOwnPropertyDescriptor", "has", "set"]) {
+    for (const method of ["defineProperty", "deleteProperty", "get", "has", "set"]) {
         handler[method] = function (_, ...args) {
             return Reflect[method](findObjectByProp(args[0]), ...args);
         };
     }
+    // Can't just forward this one like the others above: the proxy's real
+    // target is always the permanently-empty `fallback` object, which never
+    // has ANY own property. Per the getOwnPropertyDescriptor trap invariant,
+    // reporting a property as non-configurable is only valid if the target
+    // itself also has that property as non-configurable - since fallback
+    // never does, forwarding a real (possibly non-configurable) descriptor
+    // as-is throws "'getOwnPropertyDescriptor' on proxy: trap reported
+    // non-configurability for property '<name>' which is either non-existent
+    // or configurable in the proxy target" the moment anything reads that
+    // property's descriptor (Object.keys/entries, {...spread}, for...in all
+    // do this internally, same trigger as the ownKeys fix above). Forcing
+    // configurable:true keeps every other descriptor field intact and is
+    // safe here since virtualMerge's merged view was never meant to preserve
+    // real non-configurability semantics anyway.
+    handler.getOwnPropertyDescriptor = function (_, prop) {
+        const descriptor = Reflect.getOwnPropertyDescriptor(findObjectByProp(prop), prop);
+        if (descriptor)
+            descriptor.configurable = true;
+        return descriptor;
+    };
     return new Proxy(fallback, handler);
 }
 exports.default = virtualMerge;
